      "response": [
        {
          "name": "Scan Receipt example",
          "status": "OK",
          "code": 200,
          "_body": "{\n  \"success\": true,\n  \"message\": \"Payment processed\",\n  \"data\": {\n    \"cardId\": 42,\n    \"passengerName\": \"Jane Doe\",\n    \"maskedCardNumber\": \"•••• 1111\",\n    \"lockedFare\": 100.00,\n    \"remainingBalance\": 50.00,\n    \"paymentTimestamp\": \"2026-08-05T00:00:00Z\"\n  }\n}"
