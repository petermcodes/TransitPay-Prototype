    {
      "name": "Scan Physical Card (driver)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"CardNumber\": \"<PAN_here>\",\n  \"OriginStationId\": 1,\n  \"DestinationStationId\": 2\n}" },
        "url": { "raw": "{{baseUrl}}/api/payment/scan-physical", "host": ["{{baseUrl}}"], "path": ["api","payment","scan-physical"] }
