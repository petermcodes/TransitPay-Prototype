    {
      "name": "Process Conductor Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"QRData\": \"<base64-data>\",\n  \"Signature\": \"<signature>\",\n  \"OriginStationId\": 1,\n  \"DestinationStationId\": 2\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/payment/process-conductor", "host": ["{{baseUrl}}"], "path": ["api","payment","process-conductor"] }
