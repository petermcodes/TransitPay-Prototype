{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=TransitPayDB;Username=postgres;Password=${DB_PASSWORD}"
  },

  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "TransitPay.API",
    "Audience": "TransitPay.Client",
    "ExpiryHours": 8
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}