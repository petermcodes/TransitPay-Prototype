{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=TransitPayDB;Username=postgres;Password=${DB_PASSWORD}"
  },

  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "TransitPay.API",
    "Audience": "TransitPay.Client",
    "ExpiryHours": 8
  },

  "Authentication": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },

  "Payments": {
    "Gcash": {
      "MinAmount": 1,
      "MaxAmount": 10000,
      "SessionExpiryMinutes": 15
    }
  },

  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175",
      "http://192.168.50.28:5173",
      "https://five-unit-feminine.ngrok-free.dev",
      "capacitor://localhost",
      "https://localhost",
      "https://transitpay-api.onrender.com",
      "https://admin-dashboard-production-e79d.up.railway.app"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}